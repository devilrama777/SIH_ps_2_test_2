# CIL Local AI Report Generator — Environment Configuration Example
# Copy to .env for local overrides. Never commit secrets.

# Python Processing Service Configuration
PROCESSING_HOST=127.0.0.1
PROCESSING_PORT=8765
PROCESSING_LOG_LEVEL=INFO
ENVIRONMENT=development

# Storage & Cache Paths (relative to workspace root or absolute)
DATA_WORKSPACE_DIR=./data/workspace
DATA_CACHE_DIR=./data/cache
DATA_INDEX_DIR=./data/indexes

# Security Settings
# Local-first operation strictly enforced: external outbound traffic is denied by default
ALLOW_EXTERNAL_NETWORK=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost
